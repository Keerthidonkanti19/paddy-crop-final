# Development: leave unset to use Vite proxy /api → http://127.0.0.1:8000 (see vite.config.ts).
# Production build: set full API URL, e.g. https://your-api.example.com
# VITE_API_URL=https://your-api.example.com

# Optional: in dev, call the API URL directly instead of /api proxy (needs CORS on backend).
# VITE_DEV_DIRECT_API=true
# VITE_API_URL=http://127.0.0.1:8000
