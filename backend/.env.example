# Copy to `backend/.env` and adjust values

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/paddy_crop_disease_db

JWT_SECRET=replace-with-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

OTP_EXPIRE_MINUTES=10
OTP_PEPPER=replace-with-random-pepper

# Twilio (optional). If unset, OTP is printed to the API server logs (development only).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Comma-separated origins for browser requests
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
